    "LV": { text: "Läti (25%)", dx: 6, dy: 10, anchor: "start" },
    "LT": { text: "Leedu (22%)", dx: 6, dy: 4, anchor: "start" },
    "CN": { text: "Hiina (60%)", dx: 7, dy: 4, anchor: "start" },
    "BY": { text: "Valgevene (28%)", dx: 7, dy: 4, anchor: "start" },
    "DE": { text: "DE", dx: 6, dy: 3, anchor: "start" },
    "US": { text: "US", dx: -6, dy: 3, anchor: "end" },
    "JP": { text: "JP", dx: -6, dy: -3, anchor: "end" },
    "ML": { text: "ML", dx: 6, dy: 3, anchor: "start" },
    "NI": { text: "NI", dx: 6, dy: 3, anchor: "start" },
    "ZA": { text: "ZA", dx: 6, dy: 3, anchor: "start" },
    "IN": { text: "IN", dx: 6, dy: 3, anchor: "start" }
  };

  svg.selectAll(".dot")
    .data(data)
    .enter()
    .append("circle")
    .attr("class", "dot")
    .attr("cx", d => x(d.hdi))
    .attr("cy", d => y(d.sigt))
    .attr("r", d => labeledCountries[d.code] && labeledCountries[d.code].text.length > 3 ? 5.5 : 4.2)
    .attr("fill", d => getPointColor(d))
    .attr("stroke", "#ffffff")
    .attr("stroke-width", 1)
    .style("opacity", 0.92);

  svg.selectAll(".country-label")
    .data(data.filter(d => labeledCountries[d.code]))
    .enter()
    .append("text")
    .attr("class", "country-label")
    .attr("x", d => x(d.hdi) + labeledCountries[d.code].dx)
    .attr("y", d => y(d.sigt) + labeledCountries[d.code].dy)
    .attr("text-anchor", d => labeledCountries[d.code].anchor)
    .text(d => labeledCountries[d.code].text);
</script>

