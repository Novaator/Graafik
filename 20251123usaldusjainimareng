  const margin = { top: 20, right: 25, bottom: 48, left: 52 };
  const width = 670 - margin.left - margin.right;
  const height = 430 - margin.top - margin.bottom;

  const svg = d3.select("#chart")
    .append("svg")
    .attr("viewBox", `0 0 ${width + margin.left + margin.right} ${height + margin.top + margin.bottom}`)
    .append("g")
    .attr("transform", `translate(${margin.left},${margin.top})`);

  const x = d3.scaleLinear().domain([0.40, 1.00]).range([0, width]);
  const y = d3.scaleLinear().domain([0, 0.80]).range([height, 0]);

  svg.append("g")
    .attr("class", "grid")
    .attr("transform", `translate(0,${height})`)
    .call(d3.axisBottom(x).ticks(6).tickSize(-height).tickFormat(""));

  svg.append("g")
    .attr("class", "grid")
    .call(d3.axisLeft(y).ticks(8).tickSize(-width).tickFormat(""));

  const formatDecimal = d3.format(".1f");
  svg.append("g")
    .attr("class", "axis")
    .attr("transform", `translate(0,${height})`)
    .call(d3.axisBottom(x).ticks(6).tickFormat(d => String(formatDecimal(d)).replace('.', ',')));

  svg.append("g")
    .attr("class", "axis")
    .call(d3.axisLeft(y).ticks(8).tickFormat(d => Math.round(d * 100) + "%"));

  svg.append("text")
    .attr("class", "axis-label")
    .attr("x", width / 2)
    .attr("y", height + 38)
    .attr("text-anchor", "middle")
    .text("Inimarengu indeks (HDI 2021)");

  svg.append("text")
    .attr("class", "axis-label")
    .attr("transform", "rotate(-90)")
    .attr("x", -height / 2)
    .attr("y", -38)
    .attr("text-anchor", "middle")
    .text("Usaldab enamikku inimesi (SIGT)");

  svg.append("line")
    .attr("x1", x(0.80))
    .attr("x2", x(0.80))
    .attr("y1", 0)
    .attr("y2", height)
    .attr("stroke", "#66788a")
    .attr("stroke-width", 1.5)
    .attr("stroke-dasharray", "5,4");

  svg.append("text")
    .attr("x", x(0.80) - 6)
    .attr("y", 14)
    .attr("text-anchor", "end")
    .attr("font-size", "12px")
    .attr("fill", "#4a5a6a")
    .text("Väga kõrge inimarengu piir (0,80)");

  const curvePoints = [];
  for (let h = 0.42; h <= 0.975; h += 0.005) {
    const val = 0.15 + Math.exp(20.5 * (h - 0.98));
    if (val <= 0.80) {
      curvePoints.push({ hdi: h, sigt: val });
    }
  }

  const lineGenerator = d3.line()
    .x(d => x(d.hdi))
    .y(d => y(d.sigt))
    .curve(d3.curveMonotoneX);

  svg.append("path")
    .datum(curvePoints)
    .attr("fill", "none")
    .attr("stroke", "#c0392b")
    .attr("stroke-width", 2)
    .attr("d", lineGenerator);

  function getPointColor(d) {
    if (d.code === "CN" || d.code === "BY") return "#c0392b";
    if (d.code === "EE" || d.group === "nordic") return "#1b6b50";
    return "#00426a";
  }

  const labeledCountries = {
    "NO": { text: "Norra (70%)", dx: -8, dy: 4, anchor: "end" },
    "SE": { text: "Rootsi (61%)", dx: -8, dy: 3, anchor: "end" },
    "FI": { text: "Soome (55%)", dx: -8, dy: 4, anchor: "end" },
